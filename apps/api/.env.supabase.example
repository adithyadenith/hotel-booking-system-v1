# Copy this file to .env and replace the placeholders with values from
# Supabase Dashboard -> Connect -> Prisma.
# Keep DATABASE_URL on the Supavisor Session pooler for the running API.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# Keep DIRECT_URL on the direct/session connection for Prisma migrations.
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
AUTH_LOGIN_THROTTLE_LIMIT=5
PLATFORM_ADMIN_PASSWORD=replace-before-seeding
CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-secret
SANDBOX_WEBHOOK_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
EMAIL_FROM=Hotel Reservations <reservations@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
