{
  "name": "hotel-api",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --files --respawn src/main.ts",
    "db:migrate": "prisma migrate dev --name init && prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma",
    "db:migrate:active": "prisma db execute --file prisma/sql/migrate_active_reservation_items.sql --schema prisma/schema.prisma",
    "db:seed": "ts-node --files prisma/seed.ts",
    "test": "ts-node test/concurrency.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && prisma db execute --file prisma/sql/constraints.sql --schema prisma/schema.prisma && npm run db:seed",
    "db:rls": "prisma db execute --file prisma/sql/rls.sql --schema prisma/schema.prisma",
    "test:api": "ts-node test/api.ts",
    "test:features": "ts-node test/features.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/throttler": "^5",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2",
    "dotenv": "^16",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "prisma": "^6.19.3",
    "ts-node": "^10",
    "ts-node-dev": "^2",
    "typescript": "^5"
  }
}
