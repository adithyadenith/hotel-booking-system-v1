generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  RECEPTIONIST
  HOUSEKEEPING
}

enum ResStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

model Hotel {
  id                            String                     @id @default(uuid())
  slug                          String                     @unique
  name                          String
  timezone                      String                     @default("Asia/Colombo")
  currency                      String                     @default("LKR")
  widgetKey                     String                     @unique @default(uuid())
  memberships                   Membership[]
  roomTypes                     RoomType[]
  rooms                         Room[]
  guests                        Guest[]
  reservations                  Reservation[]
  auditLogs                     AuditLog[]
  rateRules                     RateRule[]
  maintenanceBlocks             MaintenanceBlock[]
  notifications                 Notification[]
  promoCodes                    PromoCode[]
  paymentGatewayConfigs         PaymentGatewayConfig[]
  refunds                       Refund[]
  deliveries                    MessageDelivery[]
  reminders                     ScheduledReminder[]
  addOns                        AddOn[]
  bookingPackages               BookingPackage[]
  roomStatusHistory             RoomStatusHistory[]
  roomInspections               RoomInspection[]
  lostFoundItems                LostFoundItem[]
  maintenanceWorkOrders         MaintenanceWorkOrder[]
  housekeepingTasks             HousekeepingTask[]
  integrationApiKeys            IntegrationApiKey[]
  webhookEndpoints              WebhookEndpoint[]
  calendarIntegrations          CalendarIntegration[]
  integrationTemplates          IntegrationTemplate[]
  channelConnections            ChannelConnection[]
  channelReservationImports     ChannelReservationImport[]
  channelStopSells              ChannelStopSell[]
  taxBp                         Int                        @default(0)
  brandColor                    String                     @default("#2563EB")
  widgetEnabled                 Boolean                    @default(true)
  widgetLogoUrl                 String?
  widgetLayout                  String                     @default("STANDARD")
  widgetMinNights               Int                        @default(1)
  widgetAdvanceDays             Int                        @default(0)
  widgetMaxGuests               Int                        @default(20)
  widgetPaymentMode             String                     @default("FULL_PAYMENT")
  widgetDepositPercent          Int                        @default(100)
  widgetConfirmationMessage     String?
  widgetConfirmationEmail       Boolean                    @default(true)
  widgetLanguages               String[]                   @default(["en", "si", "ta"])
  widgetDefaultLanguage         String                     @default("en")
  widgetCancellationPolicy      String                     @default("Flexible cancellation")
  widgetCancellationHours       Int                        @default(48)
  widgetSelfCancellationEnabled Boolean                    @default(true)
  widgetModificationEnabled     Boolean                    @default(true)
  allowedWidgetDomains          String[]                   @default([])
  suspendedAt                   DateTime?
}

model User {
  id                   String                 @id @default(uuid())
  email                String                 @unique
  name                 String
  passwordHash         String
  isPlatformAdmin      Boolean                @default(false)
  memberships          Membership[]
  roomStatusChanges    RoomStatusHistory[]    @relation("RoomStatusChangedBy")
  inspections          RoomInspection[]       @relation("InspectionBy")
  lostFoundCreated     LostFoundItem[]        @relation("LostFoundCreatedBy")
  maintenanceCreated   MaintenanceWorkOrder[] @relation("MaintenanceCreatedBy")
  maintenanceAssigned  MaintenanceWorkOrder[] @relation("MaintenanceAssignedTo")
  housekeepingCreated  HousekeepingTask[]     @relation("HousekeepingCreatedBy")
  housekeepingAssigned HousekeepingTask[]     @relation("HousekeepingAssignedTo")
}

model Membership {
  id      String @id @default(uuid())
  userId  String
  hotelId String
  role    Role
  user    User   @relation(fields: [userId], references: [id])
  hotel   Hotel  @relation(fields: [hotelId], references: [id])

  @@unique([userId, hotelId])
}

model RoomType {
  id                  String               @id @default(uuid())
  hotelId             String
  name                String
  baseRate            Int
  maxOccupancy        Int
  hotel               Hotel                @relation(fields: [hotelId], references: [id])
  rooms               Room[]
  channelRoomMappings ChannelRoomMapping[]

  @@index([hotelId])
}

model Room {
  id                    String                 @id @default(uuid())
  hotelId               String
  roomTypeId            String
  number                String
  floor                 Int
  housekeeping          String                 @default("CLEAN")
  hkAssigneeId          String?
  hkNotes               String?
  archivedAt            DateTime?
  hotel                 Hotel                  @relation(fields: [hotelId], references: [id])
  roomType              RoomType               @relation(fields: [roomTypeId], references: [id])
  nights                RoomNight[]
  items                 ReservationItem[]
  blocks                MaintenanceBlock[]
  statusHistory         RoomStatusHistory[]
  inspections           RoomInspection[]
  lostFoundItems        LostFoundItem[]
  maintenanceWorkOrders MaintenanceWorkOrder[]
  housekeepingTasks     HousekeepingTask[]

  @@unique([hotelId, number])
}

model Guest {
  id           String        @id @default(uuid())
  hotelId      String
  name         String
  email        String?
  phone        String?
  hotel        Hotel         @relation(fields: [hotelId], references: [id])
  reservations Reservation[]

  @@index([hotelId, email])
}

model Reservation {
  id             String                     @id @default(uuid())
  hotelId        String
  ref            String
  guestId        String
  status         ResStatus                  @default(PENDING)
  source         String                     @default("DIRECT")
  totalAmount    Int
  depositPaid    Int                        @default(0)
  notes          String?
  discount       Int                        @default(0)
  taxAmount      Int                        @default(0)
  promoCode      String?
  holdExpiresAt  DateTime?
  createdAt      DateTime                   @default(now())
  hotel          Hotel                      @relation(fields: [hotelId], references: [id])
  guest          Guest                      @relation(fields: [guestId], references: [id])
  items          ReservationItem[]
  payments       Payment[]
  refunds        Refund[]
  deliveries     MessageDelivery[]
  reminders      ScheduledReminder[]
  addOns         ReservationAddOn[]
  packageId      String?
  package        BookingPackage?            @relation(fields: [packageId], references: [id])
  channelImports ChannelReservationImport[]

  @@unique([hotelId, ref])
}

model ReservationItem {
  id            String      @id @default(uuid())
  reservationId String
  roomId        String
  checkIn       DateTime    @db.Date
  checkOut      DateTime    @db.Date
  adults        Int         @default(1)
  children      Int         @default(0)
  nightlyRate   Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  room          Room        @relation(fields: [roomId], references: [id])
  nights        RoomNight[]
}

model BookingPackage {
  id              String        @id @default(uuid())
  hotelId         String
  name            String
  description     String?
  discountPercent Int           @default(0)
  fixedDiscount   Int           @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hotel           Hotel         @relation(fields: [hotelId], references: [id])
  reservations    Reservation[]

  @@index([hotelId, active])
}

model AddOn {
  id           String             @id @default(uuid())
  hotelId      String
  name         String
  description  String?
  category     String             @default("EXTRA")
  pricingType  String             @default("PER_BOOKING")
  price        Int
  stockLimit   Int?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  hotel        Hotel              @relation(fields: [hotelId], references: [id])
  reservations ReservationAddOn[]

  @@index([hotelId, active])
}

model ReservationAddOn {
  id            String      @id @default(uuid())
  reservationId String
  addOnId       String
  name          String
  pricingType   String
  unitPrice     Int
  quantity      Int         @default(1)
  nights        Int         @default(1)
  totalAmount   Int
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  addOn         AddOn       @relation(fields: [addOnId], references: [id])

  @@index([addOnId])
  @@index([reservationId])
}

model RoomNight {
  id      String            @id @default(uuid())
  roomId  String
  night   DateTime          @db.Date
  itemId  String?
  blockId String?
  room    Room              @relation(fields: [roomId], references: [id])
  item    ReservationItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  block   MaintenanceBlock? @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([roomId, night])
}

model Payment {
  id                     String               @id @default(uuid())
  reservationId          String
  provider               String
  providerRef            String?
  providerTransactionRef String?
  idempotencyKey         String               @unique
  amount                 Int
  status                 String               @default("PENDING")
  createdAt              DateTime             @default(now())
  reservation            Reservation          @relation(fields: [reservationId], references: [id])
  refunds                Refund[]
  transactions           PaymentTransaction[]
}

model Refund {
  id             String      @id @default(uuid())
  hotelId        String
  reservationId  String
  paymentId      String
  amount         Int
  reason         String      @default("")
  providerRef    String?
  idempotencyKey String      @unique
  status         String      @default("PENDING")
  createdAt      DateTime    @default(now())
  createdBy      String?
  hotel          Hotel       @relation(fields: [hotelId], references: [id])
  reservation    Reservation @relation(fields: [reservationId], references: [id])
  payment        Payment     @relation(fields: [paymentId], references: [id])

  @@index([hotelId, createdAt])
}

model PaymentGatewayConfig {
  id                       String   @id @default(uuid())
  hotelId                  String
  provider                 String
  environment              String   @default("SANDBOX")
  merchantId               String?
  merchantSecretCiphertext String?
  apiTokenCiphertext       String?
  enabled                  Boolean  @default(false)
  updatedAt                DateTime @updatedAt
  hotel                    Hotel    @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, provider])
}

model PaymentTransaction {
  id          String   @id @default(uuid())
  paymentId   String
  type        String
  providerRef String?
  amount      Int
  status      String
  createdAt   DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id])

  @@index([paymentId, createdAt])
}

model MessageDelivery {
  id             String       @id @default(uuid())
  hotelId        String
  reservationId  String?
  channel        String
  messageType    String
  recipient      String
  subject        String?
  body           String
  status         String       @default("QUEUED")
  providerRef    String?
  error          String?
  attempts       Int          @default(0)
  nextAttemptAt  DateTime?
  sentAt         DateTime?
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  hotel          Hotel        @relation(fields: [hotelId], references: [id])
  reservation    Reservation? @relation(fields: [reservationId], references: [id])

  @@index([hotelId, status, nextAttemptAt])
}

model ScheduledReminder {
  id            String      @id @default(uuid())
  hotelId       String
  reservationId String
  type          String
  scheduledFor  DateTime
  status        String      @default("SCHEDULED")
  processedAt   DateTime?
  hotel         Hotel       @relation(fields: [hotelId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@unique([reservationId, type])
  @@index([hotelId, status, scheduledFor])
}

model AuditLog {
  id        String   @id @default(uuid())
  hotelId   String
  userId    String?
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
}

model RateRule {
  id           String    @id @default(uuid())
  hotelId      String
  roomTypeId   String?
  name         String
  type         String // SEASON | SPECIAL | WEEKEND
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  multiplierBp Int // 10000 = 100%
  active       Boolean   @default(true)
  hotel        Hotel     @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
}

model PromoCode {
  id         String    @id @default(uuid())
  hotelId    String
  code       String
  percentOff Int
  active     Boolean   @default(true)
  validFrom  DateTime?
  validTo    DateTime?
  hotel      Hotel     @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, code])
}

model WebhookEvent {
  id        String   @id @default(uuid())
  provider  String
  eventId   String
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}

model Notification {
  id        String    @id @default(uuid())
  hotelId   String
  type      String
  title     String
  body      String    @default("")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  hotel     Hotel     @relation(fields: [hotelId], references: [id])

  @@index([hotelId, createdAt])
}

model MaintenanceBlock {
  id        String      @id @default(uuid())
  hotelId   String
  roomId    String
  startDate DateTime    @db.Date
  endDate   DateTime    @db.Date // exclusive, like check-out
  reason    String      @default("")
  hotel     Hotel       @relation(fields: [hotelId], references: [id])
  room      Room        @relation(fields: [roomId], references: [id])
  nights    RoomNight[]

  @@index([hotelId, startDate])
}

model RoomStatusHistory {
  id          String   @id @default(uuid())
  hotelId     String
  roomId      String
  changedById String?
  fromStatus  String?
  toStatus    String
  note        String   @default("")
  createdAt   DateTime @default(now())
  hotel       Hotel    @relation(fields: [hotelId], references: [id])
  room        Room     @relation(fields: [roomId], references: [id])
  changedBy   User?    @relation("RoomStatusChangedBy", fields: [changedById], references: [id])

  @@index([hotelId, createdAt])
  @@index([roomId, createdAt])
}

model RoomInspection {
  id          String    @id @default(uuid())
  hotelId     String
  roomId      String
  inspectorId String?
  status      String    @default("PENDING")
  checklist   Json?
  notes       String    @default("")
  inspectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  hotel       Hotel     @relation(fields: [hotelId], references: [id])
  room        Room      @relation(fields: [roomId], references: [id])
  inspector   User?     @relation("InspectionBy", fields: [inspectorId], references: [id])

  @@index([hotelId, status])
  @@index([roomId, createdAt])
}

model LostFoundItem {
  id           String   @id @default(uuid())
  hotelId      String
  roomId       String?
  createdById  String?
  itemName     String
  description  String   @default("")
  location     String   @default("")
  guestName    String   @default("")
  guestContact String   @default("")
  status       String   @default("OPEN")
  notes        String   @default("")
  foundAt      DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  hotel        Hotel    @relation(fields: [hotelId], references: [id])
  room         Room?    @relation(fields: [roomId], references: [id])
  createdBy    User?    @relation("LostFoundCreatedBy", fields: [createdById], references: [id])

  @@index([hotelId, status])
  @@index([hotelId, foundAt])
}

model MaintenanceWorkOrder {
  id           String    @id @default(uuid())
  hotelId      String
  roomId       String
  createdById  String?
  assignedToId String?
  title        String
  description  String    @default("")
  category     String    @default("GENERAL")
  priority     String    @default("MEDIUM")
  status       String    @default("OPEN")
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hotel        Hotel     @relation(fields: [hotelId], references: [id])
  room         Room      @relation(fields: [roomId], references: [id])
  createdBy    User?     @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])
  assignedTo   User?     @relation("MaintenanceAssignedTo", fields: [assignedToId], references: [id])

  @@index([hotelId, status, priority])
  @@index([roomId, createdAt])
}

model HousekeepingTask {
  id           String    @id @default(uuid())
  hotelId      String
  roomId       String
  createdById  String?
  assignedToId String?
  taskType     String    @default("TURNOVER")
  status       String    @default("ASSIGNED")
  notes        String    @default("")
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hotel        Hotel     @relation(fields: [hotelId], references: [id])
  room         Room      @relation(fields: [roomId], references: [id])
  createdBy    User?     @relation("HousekeepingCreatedBy", fields: [createdById], references: [id])
  assignedTo   User?     @relation("HousekeepingAssignedTo", fields: [assignedToId], references: [id])

  @@index([hotelId, status, dueAt])
  @@index([roomId, createdAt])
}

model IntegrationApiKey {
  id         String    @id @default(uuid())
  hotelId    String
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  hotel      Hotel     @relation(fields: [hotelId], references: [id])

  @@index([hotelId, revokedAt])
}

model WebhookEndpoint {
  id             String    @id @default(uuid())
  hotelId        String
  name           String
  url            String
  secret         String
  events         Json
  active         Boolean   @default(true)
  lastStatus     String    @default("NOT_TESTED")
  lastError      String    @default("")
  lastDeliveryAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  hotel          Hotel     @relation(fields: [hotelId], references: [id])

  @@index([hotelId, active])
}

model CalendarIntegration {
  id           String    @id @default(uuid())
  hotelId      String
  name         String
  provider     String    @default("ICS")
  direction    String    @default("EXPORT")
  url          String    @default("")
  token        String    @unique
  active       Boolean   @default(true)
  lastSyncedAt DateTime?
  lastStatus   String    @default("NOT_SYNCED")
  lastError    String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hotel        Hotel     @relation(fields: [hotelId], references: [id])

  @@index([hotelId, active])
}

model IntegrationTemplate {
  id        String   @id @default(uuid())
  hotelId   String
  channel   String
  event     String
  name      String
  subject   String   @default("")
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel     Hotel    @relation(fields: [hotelId], references: [id])

  @@unique([hotelId, channel, event])
  @@index([hotelId, channel, active])
}

model ChannelConnection {
  id                    String                     @id @default(uuid())
  hotelId               String
  name                  String
  provider              String
  endpointUrl           String                     @default("")
  credentials           String                     @default("")
  active                Boolean                    @default(true)
  syncAvailability      Boolean                    @default(true)
  syncPrices            Boolean                    @default(true)
  importReservations    Boolean                    @default(true)
  stopSellProtection    Boolean                    @default(true)
  overbookingProtection Boolean                    @default(true)
  overbookingBuffer     Int                        @default(0)
  lastAvailabilityAt    DateTime?
  lastPricesAt          DateTime?
  lastReservationsAt    DateTime?
  lastStatus            String                     @default("NOT_SYNCED")
  lastError             String                     @default("")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  hotel                 Hotel                      @relation(fields: [hotelId], references: [id])
  mappings              ChannelRoomMapping[]
  syncLogs              ChannelSyncLog[]
  imports               ChannelReservationImport[]
  stopSells             ChannelStopSell[]

  @@index([hotelId, active])
}

model ChannelRoomMapping {
  id                 String            @id @default(uuid())
  connectionId       String
  roomTypeId         String
  externalRoomId     String
  externalRatePlanId String            @default("")
  enabled            Boolean           @default(true)
  connection         ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  roomType           RoomType          @relation(fields: [roomTypeId], references: [id])

  @@unique([connectionId, externalRoomId])
  @@unique([connectionId, roomTypeId])
}

model ChannelSyncLog {
  id           String            @id @default(uuid())
  connectionId String
  syncType     String
  status       String
  summary      String            @default("")
  details      Json?
  createdAt    DateTime          @default(now())
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, createdAt])
}

model ChannelReservationImport {
  id             String            @id @default(uuid())
  hotelId        String
  connectionId   String
  reservationId  String?
  externalId     String
  guestName      String
  guestEmail     String            @default("")
  guestPhone     String            @default("")
  roomTypeName   String
  checkIn        DateTime          @db.Date
  checkOut       DateTime          @db.Date
  externalAmount Int               @default(0)
  status         String            @default("IMPORTED")
  errorMessage   String            @default("")
  importedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  hotel          Hotel             @relation(fields: [hotelId], references: [id])
  connection     ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reservation    Reservation?      @relation(fields: [reservationId], references: [id])

  @@unique([connectionId, externalId])
  @@index([hotelId, importedAt])
}

model ChannelStopSell {
  id           String            @id @default(uuid())
  hotelId      String
  connectionId String
  roomTypeId   String
  dateFrom     DateTime          @db.Date
  dateTo       DateTime          @db.Date
  reason       String            @default("")
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  hotel        Hotel             @relation(fields: [hotelId], references: [id])
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([hotelId, active, dateFrom])
}
